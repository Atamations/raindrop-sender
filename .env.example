# ============================================================
# Raindrop Sender — ortam değişkenleri şablonu
# Bu dosyayı kopyalayın:  copy .env.example .env
# Sonra .env içindeki değerleri kendi bilgilerinizle doldurun.
# ASLA .env dosyasını Git'e eklemeyin / paylaşmayın.
# ============================================================

# Gmail hesabınız (gönderen adres)
GMAIL_ADDRESS=ornek@gmail.com

# Google Uygulama Şifresi (16 hane)
# Nasıl alınır: https://myaccount.google.com/apppasswords
# Not: Normal Gmail şifreniz çalışmaz; App Password gerekir.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Alıcı(lar) — birden fazla için virgülle ayırın
# Örnek: mail1@domain.com, mail2@domain.com
RECIPIENT_EMAIL=alici@ornek.com

# Durum / hata raporlarının gideceği sizin adresiniz
REPORT_EMAIL=benimailim@gmail.com

# SMTP (Gmail varsayılanları — genelde değiştirmeyin)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Mail içeriği
EMAIL_SUBJECT=Otomatik bildirim
EMAIL_BODY=Bu e-posta Windows Gorev Zamanlayicisi ile gonderildi.

# İsteğe bağlı ek dosya(lar). Boş bırakırsanız ek gitmez.
# Birden fazla dosya: noktalı virgül (;) ile ayırın.
# Örnek: C:\Users\USER\Documents\rapor.pdf;C:\Users\USER\Desktop\foto.png
ATTACHMENT_PATH=
