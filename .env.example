# Gmail hesabın (gönderen)
GMAIL_ADDRESS=ornek@gmail.com

# Google Uygulama Şifresi (16 hane)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Alıcı(lar) — birden fazla için virgülle ayır
# Örnek: mail1@domain.com, mail2@domain.com
RECIPIENT_EMAIL=alici@ornek.com

# Yalnızca hata/sorun olursa rapor maili gelen adresin
REPORT_EMAIL=benimailim@gmail.com

# SMTP (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Mail içeriği
EMAIL_SUBJECT=Otomatik bildirim
EMAIL_BODY=Bu e-posta Raindrop Mail Sender ile gönderildi.

# İsteğe bağlı ek dosya(lar). Birden fazla: ; ile ayır
# Örnek: C:\Users\ataka\Documents\rapor.pdf;C:\Users\ataka\Desktop\foto.png
ATTACHMENT_PATH=
